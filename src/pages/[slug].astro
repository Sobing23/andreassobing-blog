---
// Einzelner Artikel oder statische Seite – unter derselben Adresse wie in WordPress
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { allePosts, aehnliche, rubrik, rubrikUrl, tagUrl, datum, lesezeit, anriss, themaFuer, themaUrl, kapitelNummer, PERSON, SITE_URL, AUTOR_FOTO, brotkrumen, HANDBUCH_URL } from '../lib/blog';

export async function getStaticPaths() {
  const posts = await allePosts();
  const pages = (await getCollection('pages')).filter((p) => !['index', 'cookie-richtlinie-eu', 'das-grosse-marketing-glossar-die-wichtigsten-begriffe-einfach-erklaert'].includes(p.data.slug));
  return [
    ...posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, isPost: true } })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, isPost: false } })),
  ];
}

const { entry, isPost } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data as any;
const toc = headings.filter((h) => h.depth === 2);
const related = isPost ? await aehnliche(entry as any, 3) : [];
const beschreibung = anriss(entry as any);
const url = `${SITE_URL}/${d.slug}/`;
const jsonld: object[] = [];
if (isPost) {
  jsonld.push({
    '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${url}#artikel`, mainEntityOfPage: url, url,
    headline: d.title, description: beschreibung, inLanguage: 'de-DE',
    datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(),
    ...(d.image ? { image: new URL(d.image, SITE_URL).toString() } : {}),
    author: PERSON, publisher: PERSON,
    ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  });
}
if (d.slug === 'ueber-mich') jsonld.push({ '@context': 'https://schema.org', '@type': 'ProfilePage', url, mainEntity: PERSON });
const thema = isPost ? themaFuer(d.slug) : undefined;
let nachbarn: any[] = [];
if (thema) {
  const alle = await allePosts();
  // die nächsten Artikel im Abschnitt (zyklisch), damit sich die Links gleichmäßig verteilen
  const liste = thema.abschnitt.artikel;
  const i = liste.indexOf(d.slug);
  const andere = [...liste.slice(i + 1), ...liste.slice(0, i)].slice(0, 4);
  nachbarn = andere.map((s) => alle.find((p) => p.data.slug === s)).filter(Boolean);
}
if (isPost) {
  jsonld.push(brotkrumen(thema
    ? [{ name: 'Marketing-Handbuch', url: HANDBUCH_URL }, { name: thema.thema.name, url: themaUrl(thema.thema.key) }, { name: d.title, url: `/${d.slug}/` }]
    : [{ name: 'Startseite', url: '/' }, { name: rubrik(d.category).name, url: rubrikUrl(d.category) }, { name: d.title, url: `/${d.slug}/` }]));
}
---
<Base jsonld={jsonld} title={d.seoTitle || d.title} description={beschreibung} image={d.image} type={isPost ? 'article' : 'website'} kompakt>
  <main class="wrap post">
    <div class="post-head">
      {isPost && <a href={rubrikUrl(d.category)} class="kicker">{rubrik(d.category).name}</a>}
      <h1>{d.title}</h1>
      {isPost && d.description && <p class="intro">{d.description}</p>}
      {isPost && <span class="meta">Andreas Sobing · <time datetime={d.date.toISOString()}>{datum(d.date)}</time>{d.updated && <> · aktualisiert <time datetime={d.updated.toISOString()}>{datum(d.updated)}</time></>} · {lesezeit(entry.body)} Min. Lesezeit</span>}
    </div>
    {isPost && d.image && <div class="thumb ratio-21-9"><img src={d.image} alt="" fetchpriority="high"></div>}
    <div class="post-grid">
      <article class="prose" data-pagefind-body>
        <Content />
        {d.vgwort && <img class="vgwort" src={d.vgwort} width="1" height="1" alt="" loading="eager" data-pagefind-ignore>}
      </article>
      {isPost && (toc.length >= 3 || d.tags.length > 0 || thema) && (
        <aside class="post-aside">
          {thema && (
            <a class="thema-chip" href={themaUrl(thema.thema.key)}><span class="label">Handbuch · Kapitel {kapitelNummer(thema.thema.key)}</span>{thema.thema.name}: alle {thema.anzahl} Artikel</a>
          )}
          {toc.length >= 3 && (
            <nav class="toc" aria-label="Inhaltsverzeichnis">
              <span class="label">Inhalt</span>
              {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
            </nav>
          )}
          {d.tags.length > 0 && (
            <div>
              <span class="label">Schlagwörter</span>
              <div class="tag-list" style="margin-top:10px">{d.tags.map((t: string) => <a href={tagUrl(t)}>{t}</a>)}</div>
            </div>
          )}
        </aside>
      )}
    </div>
    {isPost && (
      <aside class="autor-box" aria-label="Über den Autor" data-pagefind-ignore>
        <img src={AUTOR_FOTO} alt="Andreas Sobing" width="72" height="72" loading="lazy">
        <p><strong>Andreas Sobing</strong> arbeitet seit über 20 Jahren im Marketing, online wie offline, und teilt sein Wissen hier seit 2009. Seine Schwerpunkte sind Marketingstrategie, Branding, E-Mail-Marketing und CRM. <a href="/ueber-mich/">Mehr über Andreas Sobing</a></p>
      </aside>
    )}
    {thema && (
      <section class="thema-box" aria-labelledby="thema-box-titel" data-pagefind-ignore>
        <span class="kicker">Marketing-Handbuch · Kapitel {kapitelNummer(thema.thema.key)}: {thema.thema.name}</span>
        <h2 id="thema-box-titel">Weiterlesen: {thema.abschnitt.titel}</h2>
        <ul>{nachbarn.map((p) => <li><a href={`/${p.data.slug}/`}>{p.data.title}</a></li>)}</ul>
        <a class="thema-alle" href={themaUrl(thema.thema.key)}>Zum Kapitel {thema.thema.name} mit allen {thema.anzahl} Artikeln →</a>
      </section>
    )}
    {related.length > 0 && (
      <section aria-labelledby="mehr">
        <div class="section-head"><h2 id="mehr">Das könnte dich auch interessieren</h2></div>
        <ul class="cards">{related.map((p) => <Card post={p} />)}</ul>
      </section>
    )}
  </main>
</Base>
