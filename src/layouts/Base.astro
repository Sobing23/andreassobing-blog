---
// Grundgerüst jeder Seite: Kopf, Fuß, Meta-Angaben, Video-Klick-zum-Laden
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import { RUBRIKEN, rubrikUrl } from '../lib/blog';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  aktiveRubrik?: string;
  noindex?: boolean;
  kompakt?: boolean;
  jsonld?: object[];
}
const { title, description = 'Mein digitales Notizbuch rund um Marketing, Strategie und Führung.', image, type = 'website', aktiveRubrik, noindex = false, kompakt = false, jsonld = [] } = Astro.props;
const SITE = 'Blog it Marketing';
const fullTitle = title === SITE ? SITE : `${title} – ${SITE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:site_name" content={SITE}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
  <link rel="alternate" type="application/rss+xml" title={SITE} href="/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.png">
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <div class="top" style={kompakt ? 'align-items:center;padding-bottom:18px' : undefined}>
        <a href="/" class:list={['logo', { 'logo-small': kompakt }]}>Blog it Marketing</a>
        <form class="search-form" action="/suche/" method="get" role="search">
          <label for="q" class="sr-only">Suche</label>
          <input id="q" name="q" type="search" placeholder="Artikel durchsuchen">
        </form>
      </div>
      {!kompakt && (
        <nav class="rubrik-nav" aria-label="Rubriken">
          {RUBRIKEN.map((r) => (
            <a href={rubrikUrl(r.key)} aria-current={aktiveRubrik === r.key ? 'page' : undefined}>{r.kurz}</a>
          ))}
          <a href="/handbuch/" class="nav-handbuch" aria-current={Astro.url.pathname.startsWith('/handbuch') || Astro.url.pathname.startsWith('/thema/') ? 'page' : undefined}>Handbuch</a>
          <a href="/archiv/">Archiv</a>
          <a href="/das-grosse-marketing-glossar-die-wichtigsten-begriffe-einfach-erklaert/">Glossar</a>
        </nav>
      )}
    </div>
  </header>
  <slot />
  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Andreas Sobing · Blog it Marketing</span>
      <nav aria-label="Rechtliches">
        <a href="/ueber-mich/">Über mich</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </footer>
  <script>
    // Videos erst nach Klick von YouTube/Vimeo laden (Datenschutz)
    document.querySelectorAll<HTMLElement>('.video[data-id]').forEach((el) => {
      const anbieter = el.dataset.provider === 'vimeo' ? 'Vimeo' : 'YouTube';
      el.innerHTML = '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = `▶ Video laden`;
      const hinweis = document.createElement('span');
      hinweis.textContent = `Beim Laden werden Daten an ${anbieter} übertragen.`;
      el.append(btn, hinweis);
      btn.addEventListener('click', () => {
        const src = el.dataset.provider === 'vimeo'
          ? `https://player.vimeo.com/video/${el.dataset.id}?autoplay=1&dnt=1`
          : `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1`;
        const f = document.createElement('iframe');
        f.src = src;
        f.title = `${anbieter}-Video`;
        f.allow = 'autoplay; fullscreen; picture-in-picture';
        f.allowFullscreen = true;
        el.innerHTML = '';
        el.classList.add('loaded');
        el.append(f);
      });
    });
    // Fehlende Bilder ausblenden, Platzhalterfläche bleibt
    document.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
      const weg = () => { img.style.visibility = 'hidden'; };
      if (img.complete && img.naturalWidth === 0 && img.src) weg();
      img.addEventListener('error', weg);
    });
  </script>
</body>
</html>
